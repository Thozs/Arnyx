#!/usr/bin/env bash
# .githooks/pre-commit — se src/core.sh ou backends/**/*.sh mudou neste
# commit, valida que o build funciona (build-arn.sh) e regenera aliases/
# (via build-aliases.sh, já que a seção ALIASES FISH lida de dentro do
# bin/arn recém-gerado pode ter mudado) — aliases/ continua versionado.
#
# bin/arn NÃO é commitado (está no .gitignore) — é gerado no momento da
# instalação (bootstrap.sh / bootstrap-gentoo.sh rodam build-arn.sh antes
# de instalar). Este hook só verifica que o build não quebrou.
#
# Setup (uma vez só, por clone):
#   git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Só faz algo se o núcleo (core.sh) ou algum backend estiver staged
if ! git diff --cached --name-only | grep -qE '^(src/core\.sh|backends/.*\.sh)$'; then
    exit 0
fi

echo ":: src/core.sh ou backends/ mudou — validando build-arn.sh..."

if ! ./tools/build-arn.sh; then
    echo "✗ build-arn.sh falhou — commit abortado." >&2
    exit 1
fi

echo ":: regenerando aliases/ a partir do bin/arn recém-gerado..."

if ! ./tools/build-aliases.sh; then
    echo "✗ build-aliases.sh falhou — commit abortado." >&2
    exit 1
fi

git add aliases/
echo "✓ build ok, aliases/ atualizados e incluídos neste commit (bin/arn não é commitado)."
